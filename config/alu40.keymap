#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
        undead_circum: undead_circum {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp SPACE>;
            label = "UNDEAD_CIRCUM";
        };

        undead_gravis: undead_gravis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL) &kp SPACE>;
            label = "UNDEAD_GRAVIS";
        };

        macro_note: macro_todo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_SHIFT &kp N &kp O &kp T &kp E &kt LEFT_SHIFT>;
            label = "MACRO_TODO";
        };

        macro_todo: new_macrozz {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_SHIFT &kp T &kp O &kp D &kp O &kt LEFT_SHIFT>;
            label = "NEW_MACROZZ";
        };

        macro_first: macro_first {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(C) &kp H &kp R &kp I &kp S &kp T &kp O &kp P &kp H &kp E &kp R>;
            label = "MACRO_FIRST";
        };

        macro_last: macro_last {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(K) &kp A &kp P &kp P &kp E>;
            label = "MACRO_LAST";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // | ESC/~ |  Q   |  W   |  E   |  R   |  T   |   Y   |  U    |  I   |  O   |   P   | BSPC  |
            // | TAB   |  A   |  S   |  D   |  F   |  G   |   H   |  J    |  K   |  L   |   ;   |  '    |
            // | SHIFT |  Z   |  X   |  C   |  V   |  B   |   N   |  M    |  ,   |  .   |   /   |RET/SFT|
            // | PLAY  | LCTL | LGUI | LALT | LOWR |     SPACE    |  RAIS | LARW | UARW | DARW  |  RARW |

            bindings = <
&kp TAB           &kp Y         &kp Z         &kp U             &kp A     &kp Q      &kp P      &kp B  &kp M       &kp L    &kp F       &kp J
&mo 2             &kp C         &kp S         &kp I             &kp E     &kp O      &kp D      &kp T  &kp N       &kp R    &kp H       &mo 2
&kp LSHFT         &kp V         &kp X         &kp LEFT_BRACKET  &kp APOS  &kp SEMI   &kp W      &kp G  &kp COMMA   &kp DOT  &kp K       &kp RSHFT
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &kp BACKSPACE     &mo 1     &kp SPACE  &kp SPACE  &mo 1  &kp RETURN  &mo 4    &kp DELETE  &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        lower {
            bindings = <
&kp RA(M)  &kp HOME    &kp PAGE_UP   &kp PAGE_DOWN  &kp END       &kp BACKSPACE  &kp LS(N7)             &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp RIGHT_BRACKET
&mo 3      &kp LEFT    &kp UP_ARROW  &kp DOWN       &kp RIGHT     &kp DELETE     &kp LS(RIGHT_BRACKET)  &kp N5        &kp NUMBER_6  &kp N7        &kp N8        &mo 3
&trans     &kp ESCAPE  &kp TAB       &kp INS        &kp KP_ENTER  &kp RA(MINUS)  &kp SLASH              &kp N9        &trans        &trans        &kp N0        &trans
&trans     &trans      &trans        &trans         &trans        &kp LS(SLASH)  &kp LS(SLASH)          &trans        &trans        &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        raise {
            bindings = <
&kp RS(GRAVE)  &kp RA(NUMBER_2)  &kp RA(NUMBER_3)  &kp NON_US_BSLH      &kp RS(NON_US_BSLH)    &undead_circum  &kp GRAVE      &kp RA(N7)   &kp RA(N0)        &kp LS(N0)           &kp RS(NUMBER_6)  &kp RA(Q)
&mo 3          &kp RS(NUMBER_1)  &kp MINUS         &kp RA(N8)           &kp RA(N9)             &kp RA(E)       &kp EQUAL      &kp LS(N8)   &kp LS(N9)        &kp SLASH            &kp LS(MINUS)     &mo 3
&trans         &kp NON_US_HASH   &kp RS(NUMBER_4)  &kp RA(NON_US_BSLH)  &kp RA(RIGHT_BRACKET)  &undead_gravis  &kp LS(EQUAL)  &kp PERCENT  &kp RS(NUMBER_2)  &kp LS(NON_US_HASH)  &kp RS(NUMBER_3)  &trans
&trans         &trans            &trans            &trans               &trans                 &trans          &trans         &trans       &trans            &trans               &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_DEC C_BRI_INC>;
        };

        control {
            bindings = <
&rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_SPI  &rgb_ug RGB_HUI                  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &bt BT_CLR
&trans           &rgb_ug RGB_EFR  &rgb_ug RGB_SPD  &rgb_ug RGB_HUD                  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &trans
&trans  &rgb_ug RGB_COLOR_HSB(25,78,68)  &rgb_ug RGB_COLOR_HSB(85,100,39)  &rgb_ug RGB_COLOR_HSB(145,38,54)  &rgb_ug RGB_COLOR_HSB(205,100,40)  &rgb_ug RGB_COLOR_HSB(265,95,71)  &rgb_ug RGB_COLOR_HSB(325,48,65)  &rgb_ug RGB_COLOR_HSB(0,0,62)  &rgb_ug RGB_COLOR_HSB(0,0,100)  &trans  &trans  &studio_unlock
&trans           &trans           &trans           &trans                           &trans           &trans           &trans         &trans         &trans         &trans         &bootloader    &sys_reset
            >;

            sensor-bindings = <&inc_dec_kp LG(MINUS) LG(PLUS)>;
        };

        fn {
            bindings = <
&macro_note   &kp K_MENU      &mkp MB3      &mkp LCLK       &mkp RCLK         &kp K_COFFEE      &kp C_AC_BACK     &kp F1        &kp F2        &kp F3   &kp F4      &kp C_AL_MAIL
&macro_todo   &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT   &kp K_SLEEP       &kp C_AC_FORWARD  &kp F5        &kp F6        &kp F7   &kp F8      &kp C_MEDIA_HOME
&macro_first  &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT   &kp K_POWER       &kp C_AC_HOME     &kp F9        &kp F10       &kp F11  &kp F12     &trans
&macro_last   &trans          &trans        &caps_word      &kp K_CALCULATOR  &kp K_PLAY_PAUSE  &kp K_PLAY_PAUSE  &kp C_VOL_DN  &kp C_VOL_UP  &trans   &kp K_MUTE  &trans
            >;
        };
    };
};
